<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 只用來抓持股價格（預設關閉，使用者在持股頁同意才會連線），不會送出任何記帳資料 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 訂閱到期提醒（使用者在訂閱頁打開「到期通知」才會要求）；開機後重排每天的檢查時間 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 刷卡通知選 App：列出手機上可以開啟的 App（只拿名稱與圖示） -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.MoneyBook">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".widget.QuickAddWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_quick_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick" />
        </receiver>
        <receiver
            android:name=".widget.TemplateWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_tpl_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_tpl" />
        </receiver>
        <receiver
            android:name=".widget.MonthWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_month_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_month" />
        </receiver>
        <receiver
            android:name=".widget.BudgetWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_budget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_budget" />
        </receiver>
        <receiver
            android:name=".widget.ReimbWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_reimb_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_reimb" />
        </receiver>
        <!-- 刷卡通知：使用者在系統設定打開「通知存取權」後，系統把通知交給它（只看勾選的 App，不連網） -->
        <service
            android:name=".notify.CardNotiListener"
            android:exported="true"
            android:label="記帳本刷卡通知"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- 訂閱到期通知：每天定時檢查與通知上的按鈕（不對外） -->
        <receiver
            android:name=".notify.SubNotifyReceiver"
            android:exported="false" />
        <!-- 開機、App 更新後重排檢查時間 -->
        <receiver
            android:name=".notify.SubBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="tw.moneybook.app.SUB_CHECK" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
