<?xml version="1.0" encoding="utf-8"?>
<!-- 選小工具時看到的預覽（範例數字） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wp_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="5dp">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="3dp"
        android:background="@drawable/wp_soft"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp">
        <FrameLayout android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/wp_icon">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/img_cat_food" />
        </FrameLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:orientation="vertical">
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="早餐"
        android:textSize="14sp"
        android:textColor="@color/wp_ink"
        android:maxLines="1" />
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$65"
        android:textSize="11sp"
        android:textColor="@color/wp_sub"
        android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="3dp"
        android:background="@drawable/wp_soft"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp">
        <FrameLayout android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/wp_icon">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/img_cat_transport" />
        </FrameLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:orientation="vertical">
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="捷運"
        android:textSize="14sp"
        android:textColor="@color/wp_ink"
        android:maxLines="1" />
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$35"
        android:textSize="11sp"
        android:textColor="@color/wp_sub"
        android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="3dp"
        android:background="@drawable/wp_soft"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp">
        <FrameLayout android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/wp_icon">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/img_cat_drink" />
        </FrameLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:orientation="vertical">
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="飲料"
        android:textSize="14sp"
        android:textColor="@color/wp_ink"
        android:maxLines="1" />
            <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$50"
        android:textSize="11sp"
        android:textColor="@color/wp_sub"
        android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="3dp"
        android:background="@drawable/wp_primary">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="＋"
            android:textColor="@color/wp_card"
            android:textSize="24sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
