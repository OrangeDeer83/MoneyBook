<?xml version="1.0" encoding="utf-8"?>
<!-- 選小工具時看到的預覽（範例數字） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wp_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">
    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/mascot_deer_happy" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="本月支出"
        android:textSize="12sp"
        android:textColor="@color/wp_sub"
        android:maxLines="1" />
        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$18,600"
        android:textSize="26sp"
        android:textColor="@color/wp_ink"
        android:maxLines="1"
        android:textStyle="bold" />
        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="剩餘預算 $7,400"
        android:textSize="13sp"
        android:textColor="@color/wp_ink"
        android:maxLines="1"
        android:layout_marginTop="6dp" />
        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/wp_track"
        android:orientation="horizontal">
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="7" android:background="@drawable/wp_fill" />
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3" />
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
