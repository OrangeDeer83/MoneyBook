<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MoneyBook" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
    </style>
    <!-- 放小工具時選排版：半透明背景，畫面上只有一個像對話框的卡片 -->
